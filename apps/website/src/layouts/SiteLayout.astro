---
import { ui, type Lang } from '../i18n/ui';
import { langDetectScript } from '../i18n/lang-detect.mjs';
import LanguageSwitcher from '../components/LanguageSwitcher.astro';

interface Props {
  lang: Lang;
  page: 'home' | 'mcp';
  title: string;
  description: string;
  canonicalPath: string;
  enPath: string;
  idPath: string;
}

const { lang, page, title, description, canonicalPath, enPath, idPath } = Astro.props;
const t = ui[lang];
const isHome = page === 'home';

const site = 'https://cvss.my.id';
const canonical = `${site}${canonicalPath}`;
const docsHref = lang === 'id' ? '/id/docs/' : '/docs/';
const mcpHref = lang === 'id' ? '/id/tools/mcp' : '/tools/mcp';
const themeAriaLight =
  lang === 'id' ? 'Tema warna: terang. Beralih ke gelap' : 'Color theme: light. Switch to dark';
const themeAriaDark =
  lang === 'id' ? 'Tema warna: gelap. Beralih ke terang' : 'Color theme: dark. Switch to light';
const copiedLabel = lang === 'id' ? 'Disalin' : 'Copied';
const langEnHref = page === 'home' ? '/' : '/tools/mcp';
const langIdHref = page === 'home' ? '/id/' : '/id/tools/mcp';
---

<!doctype html>
<html
  lang={lang}
  data-copy-ok={t.common.copyStatus}
  data-copy-blocked={t.common.copyBlocked}
  data-copy-manual={t.common.copyManual}
  data-copied-label={copiedLabel}
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={`${site}${enPath}`} />
    <link rel="alternate" hreflang="id" href={`${site}${idPath}`} />
    <link rel="alternate" hreflang="x-default" href={`${site}${enPath}`} />
    <link rel="preload" href="/fonts/ibm-plex-sans-600.woff2" as="font" type="font/woff2" crossorigin />
    <meta name="theme-color" content="#0c0d0f" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="CVSS.my.id" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === 'id' ? 'id_ID' : 'en_US'} />
    <meta property="og:locale:alternate" content={lang === 'id' ? 'en_US' : 'id_ID'} />
    <script is:inline set:html={langDetectScript}></script>
    <script is:inline>
      (function () {
        try {
          const t = localStorage.getItem('starlight-theme') || localStorage.getItem('theme');
          if (t === 'light' || t === 'dark') {
            document.documentElement.setAttribute('data-theme', t);
          } else {
            document.documentElement.removeAttribute('data-theme');
          }
        } catch (_) {}
      })();
    </script>
  </head>
  <body>
    <a href="#main-content" class="skip-link">{t.common.skip}</a>

    <header class="site-header">
      <div class="container header-inner">
        <a
          href={lang === 'id' ? '/id/' : '/'}
          class="brand"
          aria-label={t.common.brandHome}
          aria-current={isHome ? 'page' : undefined}
        >
          <svg class="brand-logo-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 2v3"></path>
            <path d="M3.34 19a10 10 0 1 1 17.32 0"></path>
            <path d="m12 14 4.5-4.5"></path>
            <circle cx="12" cy="14" r="1.5" fill="currentColor"></circle>
          </svg>
          <span class="brand-text"><span class="brand-name">CVSS</span><span class="brand-tld">.my.id</span></span>
        </a>
        <div class="header-right">
          <nav aria-label={t.common.primaryNav} class="site-nav">
            <a href="/calculator/v4.0">
              <svg class="nav-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="2" width="16" height="20" rx="2"></rect><line x1="8" y1="6" x2="16" y2="6"></line><line x1="16" y1="14" x2="16" y2="18"></line><path d="M16 10h.01"></path><path d="M12 10h.01"></path><path d="M8 10h.01"></path><path d="M12 14h.01"></path><path d="M8 14h.01"></path><path d="M12 18h.01"></path><path d="M8 18h.01"></path></svg>
              <span>{t.nav.calculator}</span>
            </a>
            <a href={mcpHref} aria-current={page === 'mcp' ? 'page' : undefined}>
              <svg class="nav-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect><line x1="8" y1="21" x2="16" y2="21"></line><line x1="12" y1="17" x2="12" y2="21"></line></svg>
              <span>{t.nav.mcp}</span>
            </a>
            <a href={docsHref}>
              <svg class="nav-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path></svg>
              <span>{t.nav.docs}</span>
            </a>
            {isHome ? (
              <a href="#open-source">
                <svg class="nav-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path></svg>
                <span>{t.nav.github}</span>
              </a>
            ) : (
              <a href="https://github.com/alfa-reza/cvss-calculator-mcp" rel="noopener noreferrer">
                <svg class="nav-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path></svg>
                <span>{t.nav.mcpGithub}</span>
              </a>
            )}
          </nav>
          <LanguageSwitcher lang={lang} enHref={langEnHref} idHref={langIdHref} />
          <button
            type="button"
            id="theme-toggle"
            class="theme-toggle-btn"
            aria-label={t.common.themeToggle}
            title={t.common.themeToggle}
            data-aria-light={themeAriaLight}
            data-aria-dark={themeAriaDark}
            data-label-light={t.common.themeLight}
            data-label-dark={t.common.themeDark}
          >
            <svg class="theme-icon theme-icon-sun" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="5"></circle><line x1="12" y1="1" x2="12" y2="3"></line><line x1="12" y1="21" x2="12" y2="23"></line><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line><line x1="1" y1="12" x2="3" y2="12"></line><line x1="21" y1="12" x2="23" y2="12"></line><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line></svg>
            <svg class="theme-icon theme-icon-moon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg>
            <span class="theme-toggle-text"></span>
          </button>
        </div>
      </div>
    </header>

    <slot />

    <footer class="site-footer">
      <div class="container footer-inner">
        <div class="footer-links">
          {(isHome ? t.footer.homeLinks : t.footer.mcpLinks).map((link) => (
            <a
              href={link.href}
              rel={'external' in link && link.external ? 'noopener noreferrer' : undefined}
            >{link.label}</a>
          ))}
        </div>
        <p class="footer-attribution">
          {t.footer.attribution}
          <a href="https://www.first.org/cvss/" rel="noopener noreferrer">{t.footer.attributionLink}</a>
        </p>
        <p class="footer-friendship"><a href="https://alfareza.my.id/" aria-label={lang === 'id' ? 'Build by Friendship - kunjungi portofolio Faturahman Alfareza' : 'Build by Friendship - visit Faturahman Alfareza’s portfolio'}><svg class="friendship-mark" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M12 1 13.8 8.8 20 5 16.3 11 23 12 16.3 13 20 19 13.8 15.2 12 23 10.2 15.2 4 19 7.7 13 1 12 7.7 11 4 5 10.2 8.8Z" fill="currentColor"/><circle cx="20.5" cy="3.5" r="1.2" fill="currentColor"/><circle cx="3.5" cy="20.5" r="1" fill="currentColor"/></svg><span>Build by Friendship</span><svg class="friendship-mark" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M12 1 13.8 8.8 20 5 16.3 11 23 12 16.3 13 20 19 13.8 15.2 12 23 10.2 15.2 4 19 7.7 13 1 12 7.7 11 4 5 10.2 8.8Z" fill="currentColor"/><circle cx="20.5" cy="3.5" r="1.2" fill="currentColor"/><circle cx="3.5" cy="20.5" r="1" fill="currentColor"/></svg></a></p>
      </div>
    </footer>

    <script is:inline>
      var copiedLabel = document.documentElement.dataset.copiedLabel || 'Copied';
      var copyOk = document.documentElement.dataset.copyOk || 'Copied to clipboard.';
      var copyBlocked = document.documentElement.dataset.copyBlocked || 'Clipboard blocked; select and copy the text above.';
      var copyManual = document.documentElement.dataset.copyManual || 'Select and copy the text above.';

      function flashCopied(btn) {
        if (!btn || btn.dataset.copying === 'true') return;
        var original = btn.innerHTML;
        btn.dataset.copying = 'true';
        btn.classList.add('is-copied');
        btn.innerHTML = '<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg>' + copiedLabel;
        window.setTimeout(function () {
          btn.classList.remove('is-copied');
          btn.innerHTML = original;
          delete btn.dataset.copying;
        }, 1200);
      }

      document.querySelectorAll('.copy-cmd-btn').forEach(function (btn) {
        btn.addEventListener('click', function () {
          var targetId = btn.getAttribute('data-copy-target');
          var statusId = btn.getAttribute('data-status-target');
          var codeEl = targetId ? document.getElementById(targetId) : null;
          var statusEl = statusId ? document.getElementById(statusId) : null;
          if (!codeEl) return;
          var text = codeEl.textContent || '';
          if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(text).then(
              function () {
                if (statusEl) statusEl.textContent = copyOk;
                flashCopied(btn);
              },
              function () {
                if (statusEl) statusEl.textContent = copyBlocked;
              }
            );
          } else if (statusEl) {
            statusEl.textContent = copyManual;
          }
        });
      });

      document.querySelectorAll('[data-set-lang]').forEach(function (link) {
        link.addEventListener('click', function () {
          try {
            localStorage.setItem('cvss-lang', link.getAttribute('data-set-lang'));
          } catch (_) {}
        });
      });

      (function () {
        var toggleBtn = document.getElementById('theme-toggle');
        if (!toggleBtn) return;

        var media = window.matchMedia('(prefers-color-scheme: light)');
        function updateBtn() {
          var theme =
            document.documentElement.getAttribute('data-theme') || (media.matches ? 'light' : 'dark');
          toggleBtn.setAttribute(
            'aria-label',
            theme === 'light' ? toggleBtn.dataset.ariaLight : toggleBtn.dataset.ariaDark
          );
          toggleBtn.setAttribute(
            'title',
            theme === 'light' ? toggleBtn.dataset.ariaLight : toggleBtn.dataset.ariaDark
          );
          toggleBtn.querySelector('.theme-toggle-text').textContent =
            theme === 'light' ? toggleBtn.dataset.labelLight : toggleBtn.dataset.labelDark;
        }
        toggleBtn.addEventListener('click', function () {
          var current =
            document.documentElement.getAttribute('data-theme') || (media.matches ? 'light' : 'dark');
          var next = current === 'light' ? 'dark' : 'light';
          document.documentElement.setAttribute('data-theme', next);
          try {
            localStorage.setItem('theme', next);
            localStorage.setItem('starlight-theme', next);
          } catch (_) {}
          updateBtn();
        });
        media.addEventListener('change', updateBtn);
        updateBtn();
      })();
    </script>
  </body>
</html>
