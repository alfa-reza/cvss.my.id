---
import '../styles/site.css';

const calcBaseUrl = import.meta.env.PUBLIC_CALC_URL || 'https://calc.cvss.my.id';
const localInstallCmd = 'curl -fsSL https://get.cvss.my.id/install.sh | bash';
const remoteMcpUrl = 'https://cvss.my.id/mcp';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>CVSS.my.id | CVSS 4.0, 3.1, 3.0 & 2.0 Calculator and MCP Server</title>
    <meta
      name="description"
      content="Free, open-source CVSS 4.0, 3.1, 3.0, and 2.0 calculator for security practitioners and deterministic Base Score MCP server for AI coding agents."
    />
    <link rel="canonical" href="https://cvss.my.id/" />
    <meta name="theme-color" content="#0c0d0f" />
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to main content</a>

    <header class="site-header">
      <div class="container header-inner">
        <a href="/" class="brand" aria-label="CVSS.my.id home" aria-current="page">
          <svg class="brand-logo-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 2v3"></path>
            <path d="M3.34 19a10 10 0 1 1 17.32 0"></path>
            <path d="m12 14 4.5-4.5"></path>
            <circle cx="12" cy="14" r="1.5" fill="currentColor"></circle>
          </svg>
          <span class="brand-text"><span class="brand-name">CVSS</span><span class="brand-tld">.my.id</span></span>
        </a>
        <nav aria-label="Primary navigation" class="site-nav">
          <a href={`${calcBaseUrl}/v4.0`}>Calculator</a>
          <a href="/tools/mcp">MCP</a>
          <a href="/docs/">Docs</a>
          <a href="#open-source">GitHub</a>
        </nav>
      </div>
    </header>

    <main id="main-content" class="container">
      <!-- Section 1: Hero -->
      <section class="hero-section" aria-labelledby="hero-heading">
        <h1 id="hero-heading" class="hero-title">CVSS Calculator &amp; MCP Server</h1>
        <p class="hero-lead">
          Score vulnerabilities across CVSS 4.0, 3.1, 3.0, and 2.0. Export canonical vector strings and query Base scores via local or remote MCP.
        </p>
        <div class="cta-row">
          <a href={`${calcBaseUrl}/v4.0`} class="btn btn-primary">Open Calculator</a>
          <a href="/tools/mcp" class="btn">Configure MCP Server</a>
          <a href="#quick-lookup" class="btn btn-subtle">Quick Vector Inspector</a>
        </div>
      </section>

      <!-- Section 2: Choose CVSS Version -->
      <section class="section-block" aria-labelledby="versions-heading">
        <div class="section-header">
          <h2 id="versions-heading">Choose CVSS Version</h2>
          <p>Select a specification version to score vulnerabilities and inspect metric vectors.</p>
        </div>
        <div class="version-grid">
          <a href={`${calcBaseUrl}/v4.0`} class="version-card">
            <div>
              <div class="version-card-top">
                <span class="version-name">CVSS v4.0</span>
                <span class="version-tag">Current</span>
              </div>
              <p class="version-meta">11 Base, 1 Threat, 14 Environmental, and 6 Supplemental metrics with MacroVector lookup.</p>
            </div>
            <span class="version-action">Open Calculator &rarr;</span>
          </a>

          <a href={`${calcBaseUrl}/v3.1`} class="version-card">
            <div>
              <div class="version-card-top">
                <span class="version-name">CVSS v3.1</span>
                <span class="version-tag">Standard</span>
              </div>
              <p class="version-meta">8 Base, 3 Temporal, and 11 Environmental metrics with official v3.1 formulas.</p>
            </div>
            <span class="version-action">Open Calculator &rarr;</span>
          </a>

          <a href={`${calcBaseUrl}/v3.0`} class="version-card">
            <div>
              <div class="version-card-top">
                <span class="version-name">CVSS v3.0</span>
                <span class="version-tag">Legacy v3</span>
              </div>
              <p class="version-meta">8 Base, 3 Temporal, and 11 Environmental metrics preserving legacy v3.0 Environmental equations.</p>
            </div>
            <span class="version-action">Open Calculator &rarr;</span>
          </a>

          <a href={`${calcBaseUrl}/v2.0`} class="version-card">
            <div>
              <div class="version-card-top">
                <span class="version-name">CVSS v2.0</span>
                <span class="version-tag">Historical</span>
              </div>
              <p class="version-meta">6 Base, 3 Temporal, and 5 Environmental metrics on the official Low / Medium / High scale.</p>
            </div>
            <span class="version-action">Open Calculator &rarr;</span>
          </a>
        </div>
      </section>

      <!-- Section: Quick Vector Inspector -->
      <section id="quick-lookup" class="section-block" aria-labelledby="inspector-heading">
        <div class="section-header">
          <h2 id="inspector-heading">Quick Vector Inspector</h2>
          <p>Paste a vector string to detect specification version, verify metric prefixes, and launch the calculator.</p>
        </div>
        <div class="inspector-card">
          <div class="inspector-input-row">
            <div class="inspector-field-wrap">
              <input
                type="text"
                id="inspector-input"
                class="inspector-input"
                placeholder="Paste vector (e.g. CVSS:4.0/AV:N/AC:L/AT:N/PR:N/UI:N/VC:H/VI:H/VA:H/SC:N/SI:N/SA:N)"
                spellcheck="false"
                autocomplete="off"
                aria-label="CVSS Vector String"
              />
              <button type="button" id="inspector-clear-btn" class="inspector-clear-btn" aria-label="Clear vector input" hidden>
                &times;
              </button>
            </div>
            <div class="inspector-actions">
              <button type="button" id="inspector-copy-btn" class="btn btn-secondary inspector-copy-btn" aria-label="Copy input vector">
                <span id="inspector-copy-label">Copy</span>
              </button>
              <a id="inspector-calc-link" href={`${calcBaseUrl}/v4.0`} class="btn btn-primary inspector-action-btn">
                Score in v4.0 &rarr;
              </a>
            </div>
          </div>

          <div class="inspector-meta-row">
            <div class="inspector-tags">
              <span class="inspector-label">Detected:</span>
              <span id="detected-version" class="mono-badge">CVSS v4.0</span>
              <span id="detected-status" class="mono-badge">Ready</span>
              <span class="inspector-shortcut-hint"><kbd class="kbd-hint">Enter</kbd> to score</span>
              <span class="inspector-shortcut-hint"><kbd class="kbd-hint">Esc</kbd> to clear</span>
            </div>
            <div class="preset-pills">
              <span class="inspector-label">Sample Benchmarks:</span>
              <button type="button" class="preset-pill" data-preset="CVSS:4.0/AV:N/AC:L/AT:N/PR:N/UI:N/VC:H/VI:H/VA:H/SC:H/SI:H/SA:H">v4.0 Network RCE</button>
              <button type="button" class="preset-pill" data-preset="CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:C/C:H/I:H/A:H">v3.1 Log4Shell</button>
              <button type="button" class="preset-pill" data-preset="CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:H/I:N/A:N">v3.1 Heartbleed</button>
              <button type="button" class="preset-pill" data-preset="CVSS:2.0/AV:N/AC:L/Au:N/C:C/I:C/A:C">v2.0 Historical</button>
            </div>
          </div>
        </div>
      </section>

      <!-- Section: Qualitative Severity Reference -->
      <section class="section-block" aria-labelledby="severity-heading">
        <div class="section-header">
          <h2 id="severity-heading">Qualitative Severity Scale &amp; Ranges</h2>
          <p>Standard CVSS rating thresholds and triage priority guidance across specifications.</p>
        </div>
        <div class="severity-matrix-grid">
          <div class="severity-card">
            <div class="sev-card-header">
              <span class="sev-pill sev-pill-none">None</span>
              <span class="sev-score-range">0.0</span>
            </div>
            <p class="sev-desc">No security impact on target system under tested prerequisites.</p>
          </div>
          <div class="severity-card">
            <div class="sev-card-header">
              <span class="sev-pill sev-pill-low">Low</span>
              <span class="sev-score-range">0.1 - 3.9</span>
            </div>
            <p class="sev-desc">Minimal impact, high privileges or local physical access required.</p>
          </div>
          <div class="severity-card">
            <div class="sev-card-header">
              <span class="sev-pill sev-pill-medium">Medium</span>
              <span class="sev-score-range">4.0 - 6.9</span>
            </div>
            <p class="sev-desc">Moderate impact, user interaction or specific conditions needed.</p>
          </div>
          <div class="severity-card">
            <div class="sev-card-header">
              <span class="sev-pill sev-pill-high">High</span>
              <span class="sev-score-range">7.0 - 8.9</span>
            </div>
            <p class="sev-desc">Substantial confidentiality, integrity, or availability compromise.</p>
          </div>
          <div class="severity-card">
            <div class="sev-card-header">
              <span class="sev-pill sev-pill-critical">Critical</span>
              <span class="sev-score-range">9.0 - 10.0</span>
            </div>
            <p class="sev-desc">Remote unauthenticated compromise without user interaction.</p>
          </div>
        </div>
      </section>

      <!-- Section: Base Metric Keys Reference -->
      <section class="section-block" aria-labelledby="metrics-ref-heading">
        <div class="section-header">
          <h2 id="metrics-ref-heading">Base Metric Keys Reference</h2>
          <p>Quick lookup of core metric shorthand identifiers across CVSS specifications.</p>
        </div>
        <div class="metric-ref-grid">
          <div class="metric-ref-card">
            <div class="metric-ref-top">
              <span class="mono-badge">AV</span>
              <span class="metric-ref-title">Attack Vector</span>
            </div>
            <div class="metric-chip-list">
              <span class="metric-chip"><code>N</code> Network</span>
              <span class="metric-chip"><code>A</code> Adjacent</span>
              <span class="metric-chip"><code>L</code> Local</span>
              <span class="metric-chip"><code>P</code> Physical</span>
            </div>
          </div>
          <div class="metric-ref-card">
            <div class="metric-ref-top">
              <span class="mono-badge">AC</span>
              <span class="metric-ref-title">Attack Complexity</span>
            </div>
            <div class="metric-chip-list">
              <span class="metric-chip"><code>L</code> Low</span>
              <span class="metric-chip"><code>H</code> High</span>
            </div>
          </div>
          <div class="metric-ref-card">
            <div class="metric-ref-top">
              <span class="mono-badge">AT</span>
              <span class="metric-ref-title">Attack Req (v4.0)</span>
            </div>
            <div class="metric-chip-list">
              <span class="metric-chip"><code>N</code> None</span>
              <span class="metric-chip"><code>P</code> Present</span>
            </div>
          </div>
          <div class="metric-ref-card">
            <div class="metric-ref-top">
              <span class="mono-badge">PR</span>
              <span class="metric-ref-title">Privileges Required</span>
            </div>
            <div class="metric-chip-list">
              <span class="metric-chip"><code>N</code> None</span>
              <span class="metric-chip"><code>L</code> Low</span>
              <span class="metric-chip"><code>H</code> High</span>
            </div>
          </div>
          <div class="metric-ref-card">
            <div class="metric-ref-top">
              <span class="mono-badge">UI</span>
              <span class="metric-ref-title">User Interaction</span>
            </div>
            <div class="metric-chip-list">
              <span class="metric-chip"><code>N</code> None</span>
              <span class="metric-chip"><code>P</code> Passive (v4)</span>
              <span class="metric-chip"><code>A</code> Active (v4)</span>
              <span class="metric-chip"><code>R</code> Required (v3)</span>
            </div>
          </div>
          <div class="metric-ref-card">
            <div class="metric-ref-top">
              <span class="mono-badge">Impact</span>
              <span class="metric-ref-title">VC/VI/VA &amp; SC/SI/SA</span>
            </div>
            <div class="metric-chip-list">
              <span class="metric-chip"><code>H</code> High</span>
              <span class="metric-chip"><code>L</code> Low</span>
              <span class="metric-chip"><code>N</code> None</span>
            </div>
          </div>
        </div>
      </section>

      <!-- Section 3: CVSS for AI Agents (Local first, Remote second) -->
      <section class="section-block" aria-labelledby="mcp-heading">
        <div class="section-header">
          <h2 id="mcp-heading">CVSS for AI Agents (MCP)</h2>
          <p>
            Provide AI coding agents with deterministic CVSS 2.0, 3.0, 3.1, and 4.0 Base Score calculation via the <code>calculate_cvss</code> tool.
          </p>
        </div>

        <div class="mcp-stack">
          <!-- 1. Local MCP (Recommended) -->
          <div class="mcp-panel is-recommended">
            <div class="mcp-panel-header">
              <div class="mcp-title-row">
                <h3>1. Local MCP (Recommended)</h3>
                <span class="mono-tag">stdio</span>
                <span class="mono-tag">Linux / macOS</span>
              </div>
            </div>
            <p class="mcp-desc">
              Run the open-source MCP server locally using stdio. No public endpoint rate limits.
            </p>
            <div class="command-row">
              <pre class="command-code"><code id="local-mcp-cmd">{localInstallCmd}</code></pre>
              <button
                type="button"
                class="btn copy-cmd-btn"
                data-copy-target="local-mcp-cmd"
                data-status-target="local-copy-status"
                aria-label="Copy Local MCP installer command"
              >
                Copy Command
              </button>
            </div>
            <div class="mcp-footer-row">
              <a href="/docs/mcp/local/" class="text-link">Read Local MCP installation &amp; checksum guide</a>
              <span id="local-copy-status" class="copy-status" role="status" aria-live="polite"></span>
            </div>
          </div>

          <!-- 2. Remote MCP (Free) -->
          <div class="mcp-panel">
            <div class="mcp-panel-header">
              <div class="mcp-title-row">
                <h3>2. Remote MCP (Free)</h3>
                <span class="mono-tag">Streamable HTTP</span>
              </div>
            </div>
            <p class="mcp-desc">
              Connect with Streamable HTTP. No local installation or API key required.
            </p>
            <div class="command-row">
              <pre class="command-code"><code id="remote-mcp-url">{remoteMcpUrl}</code></pre>
              <button
                type="button"
                class="btn copy-cmd-btn"
                data-copy-target="remote-mcp-url"
                data-status-target="remote-copy-status"
                aria-label="Copy Remote MCP endpoint URL"
              >
                Copy Endpoint
              </button>
            </div>
            <p class="mcp-limit-note">
              <strong>Published usage policy:</strong> Rate limit: 5 requests per minute per IP. For higher usage, run Local MCP (stdio).
            </p>
            <div class="mcp-footer-row">
              <a href="/docs/mcp/remote/" class="text-link">Read Remote MCP connection guide</a>
              <span id="remote-copy-status" class="copy-status" role="status" aria-live="polite"></span>
            </div>
          </div>
        </div>
      </section>

      <!-- Section 4: Documentation -->
      <section class="section-block" aria-labelledby="docs-heading">
        <div class="section-header">
          <h2 id="docs-heading">Documentation</h2>
          <p>Practical reference documentation for CVSS specifications, vector rules, and MCP client integrations.</p>
        </div>
        <ul class="docs-index-list">
          <li class="docs-index-item">
            <a href="/docs/cvss/overview/">CVSS Reference Guides</a>
            <p>Metric definitions, allowed values, scoring equations, and qualitative severity scales.</p>
          </li>
          <li class="docs-index-item">
            <a href="/docs/cvss/vectors/">Vector String Syntax &amp; Ordering Rules</a>
            <p>Mandatory Base metrics, strict v4.0 ordering, flexible v3.x parsing, and v2.0 notation.</p>
          </li>
          <li class="docs-index-item">
            <a href="/docs/mcp/clients/">MCP Client Setup Guides</a>
            <p>Copyable stdio and Streamable HTTP configurations for Codex, Claude Code, OpenCode, Copilot, Cursor, Pi, Kilo Code, Cline, and Hermes Agent.</p>
          </li>
          <li class="docs-index-item">
            <a href="/docs/calculator/">Using the Browser Calculator</a>
            <p>How inline vector editing, Share-on-Demand URLs, and per-version session drafts work.</p>
          </li>
        </ul>
      </section>

      <!-- Section 5: Open Source -->
      <section id="open-source" class="section-block" aria-labelledby="oss-heading">
        <div class="section-header">
          <h2 id="oss-heading">Open Source Repositories</h2>
          <p>The static website/calculator and the Go MCP server are maintained in two separate open-source repositories.</p>
        </div>
        <div class="repo-grid">
          <div class="repo-box">
            <div>
              <h3>Website, Calculator &amp; Docs</h3>
              <p>Astro static website, Starlight documentation, and CVSS 2.0 / 3.0 / 3.1 / 4.0 calculator.</p>
            </div>
            <a href="https://github.com/alfa-reza/cvss.my.id" class="repo-url" rel="noopener noreferrer" aria-label="View cvss.my.id repository on GitHub">
              View Repository &rarr;
            </a>
          </div>
          <div class="repo-box">
            <div>
              <h3>CVSS Calculator MCP (Go)</h3>
              <p>Standalone Go MCP server implementing deterministic Base Score calculation over stdio and Streamable HTTP.</p>
            </div>
            <a href="https://github.com/alfa-reza/cvss-calculator-mcp" class="repo-url" rel="noopener noreferrer" aria-label="View cvss-calculator-mcp repository on GitHub">
              View Repository &rarr;
            </a>
          </div>
        </div>
      </section>
    </main>

    <!-- Section 6: Footer -->
    <footer class="site-footer">
      <div class="container footer-inner">
        <div class="footer-links">
          <a href={`${calcBaseUrl}/v4.0`}>Calculator</a>
          <a href="/tools/mcp">MCP Overview</a>
          <a href="/docs/">Documentation</a>
          <a href="/docs/mcp/clients/">MCP Client Guides</a>
          <a href="https://github.com/alfa-reza/cvss.my.id" rel="noopener noreferrer">Website &amp; Calculator GitHub</a>
          <a href="https://github.com/alfa-reza/cvss-calculator-mcp" rel="noopener noreferrer">CVSS Calculator MCP (Go) GitHub</a>
        </div>
        <p class="footer-attribution">
          CVSS.my.id is an independent open-source project and is not affiliated with FIRST. CVSS (Common Vulnerability Scoring System) is a standard maintained by <a href="https://www.first.org/cvss/" rel="noopener noreferrer">FIRST.org, Inc.</a>
        </p>
      </div>
    </footer>

    <script is:inline define:vars={{ calcBaseUrl }}>
      document.querySelectorAll('.copy-cmd-btn').forEach(function (btn) {
        btn.addEventListener('click', function () {
          var targetId = btn.getAttribute('data-copy-target');
          var statusId = btn.getAttribute('data-status-target');
          var codeEl = targetId ? document.getElementById(targetId) : null;
          var statusEl = statusId ? document.getElementById(statusId) : null;
          if (!codeEl) return;
          var text = codeEl.textContent || '';
          if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(text).then(
              function () {
                if (statusEl) statusEl.textContent = 'Copied to clipboard.';
              },
              function () {
                if (statusEl) statusEl.textContent = 'Clipboard blocked; select and copy the text above.';
              }
            );
          } else if (statusEl) {
            statusEl.textContent = 'Select and copy the text above.';
          }
        });
      });

      // Quick Vector Inspector handler
      (function () {
        var inputEl = document.getElementById('inspector-input');
        var clearBtn = document.getElementById('inspector-clear-btn');
        var copyBtn = document.getElementById('inspector-copy-btn');
        var copyLabel = document.getElementById('inspector-copy-label');
        var calcLink = document.getElementById('inspector-calc-link');
        var versionBadge = document.getElementById('detected-version');
        var statusBadge = document.getElementById('detected-status');
        if (!inputEl || !calcLink || !versionBadge || !statusBadge) return;

        function updateInspector() {
          var val = inputEl.value.trim();
          if (clearBtn) clearBtn.hidden = val.length === 0;

          var ver = '4.0';
          var verLabel = 'CVSS v4.0';
          var statusText = 'Ready';

          if (val.startsWith('CVSS:4.0/')) {
            ver = '4.0';
            verLabel = 'CVSS v4.0';
            statusText = 'v4.0 Detected';
          } else if (val.startsWith('CVSS:3.1/')) {
            ver = '3.1';
            verLabel = 'CVSS v3.1';
            statusText = 'v3.1 Detected';
          } else if (val.startsWith('CVSS:3.0/')) {
            ver = '3.0';
            verLabel = 'CVSS v3.0';
            statusText = 'v3.0 Detected';
          } else if (val.startsWith('CVSS:2.0/') || val.startsWith('AV:') || val.startsWith('(AV:')) {
            ver = '2.0';
            verLabel = 'CVSS v2.0';
            statusText = 'v2.0 Detected';
          } else if (val.length > 0) {
            statusText = 'Unknown Prefix';
          }

          versionBadge.textContent = verLabel;
          statusBadge.textContent = statusText;

          var href = calcBaseUrl + '/v' + ver;
          if (val.length > 0) {
            href += '?vector=' + encodeURIComponent(val);
          }
          calcLink.href = href;
          calcLink.innerHTML = 'Score in v' + ver + ' &rarr;';
        }

        inputEl.addEventListener('input', updateInspector);

        inputEl.addEventListener('keydown', function (e) {
          if (e.key === 'Enter') {
            e.preventDefault();
            calcLink.click();
          } else if (e.key === 'Escape') {
            e.preventDefault();
            inputEl.value = '';
            updateInspector();
          }
        });

        if (copyBtn && copyLabel) {
          copyBtn.addEventListener('click', function () {
            var val = inputEl.value.trim();
            if (!val) return;
            if (navigator.clipboard && navigator.clipboard.writeText) {
              navigator.clipboard.writeText(val).then(
                function () {
                  copyLabel.textContent = 'Copied!';
                  setTimeout(function () {
                    copyLabel.textContent = 'Copy';
                  }, 1500);
                },
                function () {
                  copyLabel.textContent = 'Failed';
                  setTimeout(function () {
                    copyLabel.textContent = 'Copy';
                  }, 1500);
                }
              );
            }
          });
        }

        if (clearBtn) {
          clearBtn.addEventListener('click', function () {
            inputEl.value = '';
            inputEl.focus();
            updateInspector();
          });
        }

        document.querySelectorAll('.preset-pill').forEach(function (pill) {
          pill.addEventListener('click', function () {
            var preset = pill.getAttribute('data-preset');
            if (preset) {
              inputEl.value = preset;
              updateInspector();
            }
          });
        });
      })();
    </script>
  </body>
</html>
