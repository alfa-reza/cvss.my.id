---
import '../styles/site.css';

const calcBaseUrl = import.meta.env.PUBLIC_CALC_URL || 'https://calc.cvss.my.id';
const localInstallCmd = 'curl -fsSL https://get.cvss.my.id/install.sh | bash';
const remoteMcpUrl = 'https://cvss.my.id/mcp';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>CVSS.my.id | CVSS 4.0, 3.1, 3.0 & 2.0 Calculator and MCP Server</title>
    <meta
      name="description"
      content="Free, open-source CVSS 4.0, 3.1, 3.0, and 2.0 calculator for security practitioners and deterministic Base Score MCP server for AI coding agents."
    />
    <link rel="canonical" href="https://cvss.my.id/" />
    <meta name="theme-color" content="#0c0d0f" />
    <script is:inline>
      (function() {
        try {
          const t = localStorage.getItem('starlight-theme') || localStorage.getItem('theme');
          if (t === 'light' || t === 'dark') {
            document.documentElement.setAttribute('data-theme', t);
          } else {
            document.documentElement.removeAttribute('data-theme');
          }
        } catch (_) {}
      })();
    </script>
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to main content</a>

    <header class="site-header">
      <div class="container header-inner">
        <a href="/" class="brand" aria-label="CVSS.my.id home" aria-current="page">
          <svg class="brand-logo-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 2v3"></path>
            <path d="M3.34 19a10 10 0 1 1 17.32 0"></path>
            <path d="m12 14 4.5-4.5"></path>
            <circle cx="12" cy="14" r="1.5" fill="currentColor"></circle>
          </svg>
          <span class="brand-text"><span class="brand-name">CVSS</span><span class="brand-tld">.my.id</span></span>
        </a>
        <div class="header-right">
          <nav aria-label="Primary navigation" class="site-nav">
            <a href={`${calcBaseUrl}/v4.0`}>
              <svg class="nav-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="2" width="16" height="20" rx="2"></rect><line x1="8" y1="6" x2="16" y2="6"></line><line x1="16" y1="14" x2="16" y2="18"></line><path d="M16 10h.01"></path><path d="M12 10h.01"></path><path d="M8 10h.01"></path><path d="M12 14h.01"></path><path d="M8 14h.01"></path><path d="M12 18h.01"></path><path d="M8 18h.01"></path></svg>
              <span>Calculator</span>
            </a>
            <a href="/tools/mcp">
              <svg class="nav-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect><line x1="8" y1="21" x2="16" y2="21"></line><line x1="12" y1="17" x2="12" y2="21"></line></svg>
              <span>MCP</span>
            </a>
            <a href="/docs/">
              <svg class="nav-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path></svg>
              <span>Docs</span>
            </a>
            <a href="#open-source">
              <svg class="nav-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path></svg>
              <span>GitHub</span>
            </a>
          </nav>
          <button type="button" id="theme-toggle" class="theme-toggle-btn" aria-label="Toggle color theme" title="Toggle theme">
            <svg class="theme-icon theme-icon-sun" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="5"></circle><line x1="12" y1="1" x2="12" y2="3"></line><line x1="12" y1="21" x2="12" y2="23"></line><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line><line x1="1" y1="12" x2="3" y2="12"></line><line x1="21" y1="12" x2="23" y2="12"></line><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line></svg>
            <svg class="theme-icon theme-icon-moon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg>
            <span class="theme-toggle-text"></span>
          </button>
        </div>
      </div>
    </header>

    <main id="main-content" class="container">
      <!-- Section 1: Hero -->
      <section class="hero-section" aria-labelledby="hero-heading">
        <h1 id="hero-heading" class="hero-title">CVSS Calculator &amp; MCP Server</h1>
        <p class="hero-lead">
          Score vulnerabilities across CVSS 4.0, 3.1, 3.0, and 2.0. Export canonical vector strings and query Base scores via local or remote MCP.
        </p>
        <div class="cta-row">
          <a href={`${calcBaseUrl}/v4.0`} class="btn btn-primary">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="4" y="2" width="16" height="20" rx="2"></rect>
              <line x1="8" y1="6" x2="16" y2="6"></line>
              <line x1="16" y1="14" x2="16" y2="18"></line>
              <path d="M16 10h.01"></path>
              <path d="M12 10h.01"></path>
              <path d="M8 10h.01"></path>
              <path d="M12 14h.01"></path>
              <path d="M8 14h.01"></path>
              <path d="M12 18h.01"></path>
              <path d="M8 18h.01"></path>
            </svg>
            Open Calculator
          </a>
          <a href="/tools/mcp" class="btn">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
              <line x1="8" y1="21" x2="16" y2="21"></line>
              <line x1="12" y1="17" x2="12" y2="21"></line>
            </svg>
            Configure MCP Server
          </a>
          <a href="/docs/" class="btn">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path>
              <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path>
            </svg>
            Documentation
          </a>
        </div>
      </section>

      <!-- Section 2: Choose CVSS Version -->
      <section class="section-block" aria-labelledby="versions-heading">
        <div class="section-header">
          <h2 id="versions-heading">Choose CVSS Version</h2>
          <p>Select a specification version to score vulnerabilities and inspect metric vectors.</p>
        </div>
        <div class="version-grid">
          <a href={`${calcBaseUrl}/v4.0`} class="version-card">
            <div>
              <div class="version-card-top">
                <span class="version-name">CVSS v4.0</span>
                <span class="version-tag">Current</span>
              </div>
              <p class="version-meta">11 Base, 1 Threat, 14 Environmental, and 6 Supplemental metrics with MacroVector lookup.</p>
              <div class="version-card-meta-tags">
                <span class="version-subtag">32 Metrics</span>
                <span class="version-subtag">MacroVector</span>
              </div>
            </div>
            <span class="version-action">
              <span>Open Calculator</span>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </span>
          </a>

          <a href={`${calcBaseUrl}/v3.1`} class="version-card">
            <div>
              <div class="version-card-top">
                <span class="version-name">CVSS v3.1</span>
                <span class="version-tag">Standard</span>
              </div>
              <p class="version-meta">8 Base, 3 Temporal, and 11 Environmental metrics with official v3.1 formulas.</p>
              <div class="version-card-meta-tags">
                <span class="version-subtag">22 Metrics</span>
                <span class="version-subtag">Scope (U/C)</span>
              </div>
            </div>
            <span class="version-action">
              <span>Open Calculator</span>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </span>
          </a>

          <a href={`${calcBaseUrl}/v3.0`} class="version-card">
            <div>
              <div class="version-card-top">
                <span class="version-name">CVSS v3.0</span>
                <span class="version-tag">Legacy v3</span>
              </div>
              <p class="version-meta">8 Base, 3 Temporal, and 11 Environmental metrics preserving legacy v3.0 Environmental equations.</p>
              <div class="version-card-meta-tags">
                <span class="version-subtag">22 Metrics</span>
                <span class="version-subtag">Legacy Equ</span>
              </div>
            </div>
            <span class="version-action">
              <span>Open Calculator</span>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </span>
          </a>

          <a href={`${calcBaseUrl}/v2.0`} class="version-card">
            <div>
              <div class="version-card-top">
                <span class="version-name">CVSS v2.0</span>
                <span class="version-tag">Historical</span>
              </div>
              <p class="version-meta">6 Base, 3 Temporal, and 5 Environmental metrics on the official Low / Medium / High scale.</p>
              <div class="version-card-meta-tags">
                <span class="version-subtag">14 Metrics</span>
                <span class="version-subtag">Low/Med/High</span>
              </div>
            </div>
            <span class="version-action">
              <span>Open Calculator</span>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </span>
          </a>
        </div>
      </section>

      <!-- Section 3: CVSS for AI Agents (Local first, Remote second) -->
      <section class="section-block" aria-labelledby="mcp-heading">
        <div class="section-header">
          <h2 id="mcp-heading">CVSS for AI Agents (MCP)</h2>
          <p>
            Provide AI coding agents with deterministic CVSS 2.0, 3.0, 3.1, and 4.0 Base Score calculation via the <code>calculate_cvss</code> tool.
          </p>
        </div>

        <div class="mcp-stack">
          <!-- 1. Local MCP (Recommended) -->
          <div class="mcp-panel is-recommended">
            <div class="mcp-panel-header">
              <div class="mcp-title-row">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <polyline points="4 17 10 11 4 5"></polyline>
                  <line x1="12" y1="19" x2="20" y2="19"></line>
                </svg>
                <h3>1. Local MCP (Recommended)</h3>
                <span class="mono-tag">stdio</span>
                <span class="mono-tag">Linux / macOS</span>
              </div>
            </div>
            <p class="mcp-desc">
              Run the open-source MCP server locally using stdio. No public endpoint rate limits.
            </p>
            <div class="command-row">
              <pre class="command-code"><code id="local-mcp-cmd">{localInstallCmd}</code></pre>
              <button
                type="button"
                class="btn copy-cmd-btn"
                data-copy-target="local-mcp-cmd"
                data-status-target="local-copy-status"
                aria-label="Copy Local MCP installer command"
              >
                Copy Command
              </button>
            </div>
            <div class="mcp-footer-row">
              <a href="/docs/mcp/local/" class="text-link">Read Local MCP installation &amp; checksum guide</a>
              <span id="local-copy-status" class="copy-status" role="status" aria-live="polite"></span>
            </div>
          </div>

          <!-- 2. Remote MCP (Free) -->
          <div class="mcp-panel">
            <div class="mcp-panel-header">
              <div class="mcp-title-row">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <circle cx="12" cy="12" r="10"></circle>
                  <line x1="2" y1="12" x2="22" y2="12"></line>
                  <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
                </svg>
                <h3>2. Remote MCP (Free)</h3>
                <span class="mono-tag">Streamable HTTP</span>
              </div>
            </div>
            <p class="mcp-desc">
              Connect with Streamable HTTP. No local installation or API key required.
            </p>
            <div class="command-row">
              <pre class="command-code"><code id="remote-mcp-url">{remoteMcpUrl}</code></pre>
              <button
                type="button"
                class="btn copy-cmd-btn"
                data-copy-target="remote-mcp-url"
                data-status-target="remote-copy-status"
                aria-label="Copy Remote MCP endpoint URL"
              >
                Copy Endpoint
              </button>
            </div>
            <p class="mcp-limit-note">
              <strong>Published usage policy:</strong> Rate limit: 5 requests per minute per IP. For higher usage, run Local MCP (stdio).
            </p>
            <div class="mcp-footer-row">
              <a href="/docs/mcp/remote/" class="text-link">Read Remote MCP connection guide</a>
              <span id="remote-copy-status" class="copy-status" role="status" aria-live="polite"></span>
            </div>
          </div>
        </div>
      </section>

      <!-- Section 4: Documentation -->
      <section class="section-block" aria-labelledby="docs-heading">
        <div class="section-header">
          <h2 id="docs-heading">Documentation</h2>
          <p>Practical reference documentation for CVSS specifications, vector rules, and MCP client integrations.</p>
        </div>
        <ul class="docs-index-list">
          <li class="docs-index-item">
            <div class="docs-item-title-row">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1-2.5-2.5Z"></path>
              </svg>
              <a href="/docs/cvss/overview/">CVSS Reference Guides</a>
            </div>
            <p>Metric definitions, allowed values, scoring equations, and qualitative severity scales.</p>
          </li>
          <li class="docs-index-item">
            <div class="docs-item-title-row">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polyline points="16 18 22 12 16 6"></polyline>
                <polyline points="8 6 2 12 8 18"></polyline>
              </svg>
              <a href="/docs/cvss/vectors/">Vector String Syntax &amp; Ordering Rules</a>
            </div>
            <p>Mandatory Base metrics, strict v4.0 ordering, flexible v3.x parsing, and v2.0 notation.</p>
          </li>
          <li class="docs-index-item">
            <div class="docs-item-title-row">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
                <line x1="8" y1="21" x2="16" y2="21"></line>
                <line x1="12" y1="17" x2="12" y2="21"></line>
              </svg>
              <a href="/docs/mcp/clients/">MCP Client Setup Guides</a>
            </div>
            <p>Setup guides for selected MCP agents and editors using stdio or Streamable HTTP. Other compatible clients may also work.</p>
          </li>
          <li class="docs-index-item">
            <div class="docs-item-title-row">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="4" y="2" width="16" height="20" rx="2"></rect>
                <line x1="8" y1="6" x2="16" y2="6"></line>
              </svg>
              <a href="/docs/calculator/">Using the Browser Calculator</a>
            </div>
            <p>How inline vector editing, hybrid form controls, and score export work.</p>
          </li>
        </ul>
      </section>

      <!-- Section 5: Open Source -->
      <section id="open-source" class="section-block" aria-labelledby="oss-heading">
        <div class="section-header">
          <h2 id="oss-heading">Open Source Repositories</h2>
          <p>The static website/calculator and the Go MCP server are maintained in two separate open-source repositories.</p>
        </div>
        <div class="repo-grid">
          <div class="repo-box">
            <div>
              <div class="repo-header-top">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path>
                </svg>
                <h3>Website, Calculator &amp; Docs</h3>
              </div>
              <p>Astro static website, Starlight documentation, and CVSS 2.0, 3.0, 3.1, and 4.0 client-side calculator.</p>
              <div class="repo-tag-list">
                <span class="repo-tag">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <line x1="6" y1="3" x2="6" y2="15"></line>
                    <circle cx="18" cy="6" r="3"></circle>
                    <circle cx="6" cy="18" r="3"></circle>
                    <path d="M18 9a9 9 0 0 1-9 9"></path>
                  </svg>
                  main
                </span>
                <span class="repo-tag">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <polyline points="16 18 22 12 16 6"></polyline>
                    <polyline points="8 6 2 12 8 18"></polyline>
                  </svg>
                  TypeScript
                </span>
                <span class="repo-tag">Astro 5</span>
                <span class="repo-tag">Starlight</span>
                <span class="repo-tag">Cloudflare Pages</span>
                <span class="repo-tag">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                  </svg>
                  Apache-2.0
                </span>
              </div>
            </div>
            <a href="https://github.com/alfa-reza/cvss.my.id" class="repo-url" rel="noopener noreferrer" aria-label="View cvss.my.id repository on GitHub">
              <span>View Repository</span>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <line x1="7" y1="17" x2="17" y2="7"></line>
                <polyline points="7 7 17 7 17 17"></polyline>
              </svg>
            </a>
          </div>

          <div class="repo-box">
            <div>
              <div class="repo-header-top">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path>
                </svg>
                <h3>CVSS Calculator MCP (Go)</h3>
              </div>
              <p>Standalone Go MCP server implementing deterministic Base Score calculation over stdio and Streamable HTTP.</p>
              <div class="repo-tag-list">
                <span class="repo-tag">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <line x1="6" y1="3" x2="6" y2="15"></line>
                    <circle cx="18" cy="6" r="3"></circle>
                    <circle cx="6" cy="18" r="3"></circle>
                    <path d="M18 9a9 9 0 0 1-9 9"></path>
                  </svg>
                  main
                </span>
                <span class="repo-tag">
