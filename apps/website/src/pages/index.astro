---
import '../styles/site.css';
import SiteLayout from '../layouts/SiteLayout.astro';
import HomeView from '../components/HomeView.astro';
import { ui } from '../i18n/ui';

const t = ui.en;
---

<SiteLayout
  lang="en"
  page="home"
  title={t.meta.homeTitle}
  description={t.meta.homeDescription}
  canonicalPath="/"
  enPath="/"
  idPath="/id/"
>
  <HomeView lang="en" />
</SiteLayout>
