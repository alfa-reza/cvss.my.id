---
import '../../styles/site.css';

const calcBaseUrl = import.meta.env.PUBLIC_CALC_URL || 'https://calc.cvss.my.id';
const localInstallCmd = 'curl -fsSL https://get.cvss.my.id/install.sh | bash';
const remoteMcpUrl = 'https://cvss.my.id/mcp';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>CVSS Calculator MCP Server for AI Agents | CVSS.my.id</title>
    <meta
      name="description"
      content="Deterministic CVSS 2.0, 3.0, 3.1, and 4.0 Base Score calculation for AI coding agents via the open-source Go MCP server (stdio and Streamable HTTP)."
    />
    <link rel="canonical" href="https://cvss.my.id/tools/mcp" />
    <meta name="theme-color" content="#0c0d0f" />
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to main content</a>

    <header class="site-header">
      <div class="container header-inner">
        <a href="/" class="brand">CVSS.my.id</a>
        <nav aria-label="Primary navigation" class="site-nav">
          <a href={`${calcBaseUrl}/v4.0`}>Calculator</a>
          <a href="/tools/mcp" aria-current="page">MCP</a>
          <a href="/docs/">Docs</a>
          <a href="https://github.com/alfa-reza/cvss-calculator-mcp" rel="noopener noreferrer">MCP GitHub</a>
        </nav>
      </div>
    </header>

    <main id="main-content" class="container">
      <section class="hero-section" aria-labelledby="mcp-page-heading">
        <h1 id="mcp-page-heading" class="hero-title">CVSS Calculator MCP Server</h1>
        <p class="hero-lead">
          Language models frequently miscalculate CVSS scores when estimating weights or MacroVector lookups in text. The open-source <code>cvss-calculator-mcp</code> server gives AI coding agents a deterministic <code>calculate_cvss</code> tool for CVSS 2.0, 3.0, 3.1, and 4.0 Base Scores.
        </p>
        <div class="cta-row">
          <a href="/docs/mcp/clients/" class="btn btn-primary">View Client Setup Guides</a>
          <a href="/docs/mcp/tools/" class="btn">Read Tool Reference</a>
          <a href="https://github.com/alfa-reza/cvss-calculator-mcp" class="btn" rel="noopener noreferrer">Go MCP Repository</a>
        </div>
      </section>

      <section class="section-block" aria-labelledby="scope-heading">
        <div class="section-header">
          <h2 id="scope-heading">Product Scope: MCP Server vs. Browser Calculator</h2>
          <p>The Go MCP server and the browser calculator serve distinct workflows.</p>
        </div>
        <div class="spec-table-wrap">
          <table class="spec-table">
            <thead>
              <tr>
                <th>Capability</th>
                <th>Browser Calculator</th>
                <th>CVSS Calculator MCP (Go)</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>Supported CVSS Versions</td>
                <td>4.0, 3.1, 3.0, 2.0</td>
                <td>4.0, 3.1, 3.0, 2.0</td>
              </tr>
              <tr>
                <td>Metric Group Coverage</td>
                <td>Full (Base, Threat, Temporal, Environmental, Supplemental)</td>
                <td><strong>Base Score only</strong> (rejects non-Base metrics)</td>
              </tr>
              <tr>
                <td>Execution Environment</td>
                <td>Client-side TypeScript in your browser</td>
                <td>Local Go binary (<code>stdio</code>) or Remote Worker (Streamable HTTP)</td>
              </tr>
              <tr>
                <td>CVE Lookup / Scanning</td>
                <td>Not included (pure vector/metric calculator)</td>
                <td>Not included (deterministic vector calculation only)</td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>

      <section class="section-block" aria-labelledby="setup-heading">
        <div class="section-header">
          <h2 id="setup-heading">Installation &amp; Connection Options</h2>
          <p>Use Local MCP over stdio for unrestricted local usage, or connect to the free Remote Streamable HTTP endpoint.</p>
        </div>

        <div class="mcp-stack">
          <div class="mcp-panel is-recommended">
            <div class="mcp-panel-header">
              <div class="mcp-title-row">
                <h3>1. Local MCP (Recommended)</h3>
                <span class="mono-tag">stdio</span>
                <span class="mono-tag">Linux / macOS</span>
              </div>
            </div>
            <p class="mcp-desc">
              Run the open-source MCP server locally using stdio. No public endpoint rate limits.
            </p>
            <div class="command-row">
              <pre class="command-code"><code id="mcp-local-cmd">{localInstallCmd}</code></pre>
              <button
                type="button"
                class="btn copy-cmd-btn"
                data-copy-target="mcp-local-cmd"
                data-status-target="mcp-local-status"
              >
                Copy Command
              </button>
            </div>
            <div class="mcp-footer-row">
              <a href="/docs/mcp/local/" class="text-link">Local installation, Windows binaries &amp; checksum verification</a>
              <span id="mcp-local-status" class="copy-status" role="status" aria-live="polite"></span>
            </div>
          </div>

          <div class="mcp-panel">
            <div class="mcp-panel-header">
              <div class="mcp-title-row">
                <h3>2. Remote MCP (Free)</h3>
                <span class="mono-tag">Streamable HTTP</span>
              </div>
            </div>
            <p class="mcp-desc">
              Connect with Streamable HTTP. No local installation or API key required. Note: <code>https://cvss.my.id/mcp</code> is an MCP protocol endpoint for clients, not a web page.
            </p>
            <div class="command-row">
              <pre class="command-code"><code id="mcp-remote-url">{remoteMcpUrl}</code></pre>
              <button
                type="button"
                class="btn copy-cmd-btn"
                data-copy-target="mcp-remote-url"
                data-status-target="mcp-remote-status"
              >
                Copy Endpoint
              </button>
            </div>
            <p class="mcp-limit-note">
              <strong>Published usage policy:</strong> Rate limit: 5 requests per minute per IP. For higher usage, run Local MCP (stdio).
            </p>
            <div class="mcp-footer-row">
              <a href="/docs/mcp/remote/" class="text-link">Remote endpoint configuration &amp; rate policy details</a>
              <span id="mcp-remote-status" class="copy-status" role="status" aria-live="polite"></span>
            </div>
          </div>
        </div>
      </section>

      <section class="section-block" aria-labelledby="contract-heading">
        <div class="section-header">
          <h2 id="contract-heading">Tool Contract: <code>calculate_cvss</code></h2>
          <p>The MCP server exposes a single deterministic tool that validates a complete Base vector and returns the score and qualitative severity.</p>
        </div>
        <div class="repo-grid">
          <div class="repo-box">
            <div>
              <h3>Input Arguments</h3>
              <p>Requires <code>version</code> (<code>"2.0"</code>, <code>"3.0"</code>, <code>"3.1"</code>, or <code>"4.0"</code>) and a complete, case-sensitive Base-only <code>vector</code> string.</p>
            </div>
            <pre class="command-code"><code>{`{"version":"3.1","vector":"CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:H/I:H/A:H"}`}</code></pre>
          </div>
          <div class="repo-box">
            <div>
              <h3>Output Payload</h3>
              <p>Returns JSON text content with the validated <code>version</code>, canonical <code>vector</code>, numeric <code>score</code>, and qualitative <code>severity</code>.</p>
            </div>
            <pre class="command-code"><code>{`{"version":"3.1","vector":"CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:H/I:H/A:H","score":9.8,"severity":"Critical"}`}</code></pre>
          </div>
        </div>
      </section>

      <section class="section-block" aria-labelledby="next-steps-heading">
        <div class="section-header">
          <h2 id="next-steps-heading">Client Guides &amp; Documentation</h2>
          <p>Configure your preferred AI coding assistant using our static step-by-step guides.</p>
        </div>
        <ul class="docs-index-list">
          <li class="docs-index-item">
            <a href="/docs/mcp/clients/">Client Configuration Index</a>
            <p>Setup guides for Codex, Claude Code, OpenCode, GitHub Copilot, Cursor, Pi, Kilo Code, Cline, and Hermes Agent.</p>
          </li>
          <li class="docs-index-item">
            <a href="/docs/mcp/tools/">Detailed Tool Reference</a>
            <p>Input validation rules, error responses, and Base-only constraints for <code>calculate_cvss</code>.</p>
          </li>
          <li class="docs-index-item">
            <a href="/docs/mcp/security/">Security &amp; Privacy Considerations</a>
            <p>Binary checksum verification, network exposure, and vector data handling.</p>
          </li>
          <li class="docs-index-item">
            <a href={`${calcBaseUrl}/v4.0`}>Need Threat, Temporal, or Environmental Scores?</a>
            <p>Launch the interactive client-side calculator for complete multi-group evaluation.</p>
          </li>
        </ul>
      </section>
    </main>

    <footer class="site-footer">
      <div class="container footer-inner">
        <div class="footer-links">
          <a href="/">Home</a>
          <a href={`${calcBaseUrl}/v4.0`}>Calculator</a>
          <a href="/docs/mcp/">MCP Docs</a>
          <a href="/docs/mcp/clients/">Client Setup Guides</a>
          <a href="https://github.com/alfa-reza/cvss.my.id" rel="noopener noreferrer">Website &amp; Calculator GitHub</a>
          <a href="https://github.com/alfa-reza/cvss-calculator-mcp" rel="noopener noreferrer">CVSS Calculator MCP (Go) GitHub</a>
        </div>
        <p class="footer-attribution">
          CVSS.my.id is an independent open-source project and is not affiliated with FIRST. CVSS is maintained by <a href="https://www.first.org/cvss/" rel="noopener noreferrer">FIRST.org, Inc.</a>
        </p>
      </div>
    </footer>

    <script is:inline>
      document.querySelectorAll('.copy-cmd-btn').forEach(function (btn) {
        btn.addEventListener('click', function () {
          var targetId = btn.getAttribute('data-copy-target');
          var statusId = btn.getAttribute('data-status-target');
          var codeEl = targetId ? document.getElementById(targetId) : null;
          var statusEl = statusId ? document.getElementById(statusId) : null;
          if (!codeEl) return;
          var text = codeEl.textContent || '';
          if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(text).then(
              function () {
                if (statusEl) statusEl.textContent = 'Copied to clipboard.';
              },
              function () {
                if (statusEl) statusEl.textContent = 'Clipboard blocked; select and copy the text above.';
              }
            );
          } else if (statusEl) {
            statusEl.textContent = 'Select and copy the text above.';
          }
        });
      });
    </script>
  </body>
</html>
