---
import '../../styles/site.css';
import McpStatus from '../../components/McpStatus.astro';

const calcBaseUrl = '/calculator';
const localInstallCmd = 'curl -fsSL https://get.cvss.my.id/install.sh | bash';
const remoteMcpUrl = 'https://cvss.my.id/mcp';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>CVSS Calculator MCP Server for AI Agents | CVSS.my.id</title>
    <meta
      name="description"
      content="Calculate CVSS Base Scores from an MCP client. Supports CVSS 2.0, 3.0, 3.1, and 4.0."
    />
    <link rel="canonical" href="https://cvss.my.id/tools/mcp" />
    <link rel="preload" href="/fonts/ibm-plex-sans-600.woff2" as="font" type="font/woff2" crossorigin />
    <meta name="theme-color" content="#0c0d0f" />
    <script is:inline>
      (function() {
        try {
          const t = localStorage.getItem('starlight-theme') || localStorage.getItem('theme');
          if (t === 'light' || t === 'dark') {
            document.documentElement.setAttribute('data-theme', t);
          } else {
            document.documentElement.removeAttribute('data-theme');
          }
        } catch (_) {}
      })();
    </script>
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to main content</a>

    <header class="site-header">
      <div class="container header-inner">
        <a href="/" class="brand" aria-label="CVSS.my.id home">
          <svg class="brand-logo-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 2v3"></path>
            <path d="M3.34 19a10 10 0 1 1 17.32 0"></path>
            <path d="m12 14 4.5-4.5"></path>
            <circle cx="12" cy="14" r="1.5" fill="currentColor"></circle>
          </svg>
          <span class="brand-text"><span class="brand-name">CVSS</span><span class="brand-tld">.my.id</span></span>
        </a>
        <div class="header-right">
          <nav aria-label="Primary navigation" class="site-nav">
            <a href={`${calcBaseUrl}/v4.0`}>
              <svg class="nav-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="2" width="16" height="20" rx="2"></rect><line x1="8" y1="6" x2="16" y2="6"></line><line x1="16" y1="14" x2="16" y2="18"></line><path d="M16 10h.01"></path><path d="M12 10h.01"></path><path d="M8 10h.01"></path><path d="M12 14h.01"></path><path d="M8 14h.01"></path><path d="M12 18h.01"></path><path d="M8 18h.01"></path></svg>
              <span>Calculator</span>
            </a>
            <a href="/tools/mcp" aria-current="page">
              <svg class="nav-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect><line x1="8" y1="21" x2="16" y2="21"></line><line x1="12" y1="17" x2="12" y2="21"></line></svg>
              <span>MCP</span>
            </a>
            <a href="/docs/">
              <svg class="nav-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path></svg>
              <span>Docs</span>
            </a>
            <a href="https://github.com/alfa-reza/cvss-calculator-mcp" rel="noopener noreferrer">
              <svg class="nav-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path></svg>
              <span>MCP GitHub</span>
            </a>
          </nav>
          <button type="button" id="theme-toggle" class="theme-toggle-btn" aria-label="Toggle color theme" title="Toggle theme">
            <svg class="theme-icon theme-icon-sun" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="5"></circle><line x1="12" y1="1" x2="12" y2="3"></line><line x1="12" y1="21" x2="12" y2="23"></line><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line><line x1="1" y1="12" x2="3" y2="12"></line><line x1="21" y1="12" x2="23" y2="12"></line><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line></svg>
            <svg class="theme-icon theme-icon-moon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg>
            <span class="theme-toggle-text"></span>
          </button>
        </div>
      </div>
    </header>

    <main id="main-content" class="container">
      <section class="hero-section" aria-labelledby="mcp-page-heading">
        <h1 id="mcp-page-heading" class="hero-title">CVSS Calculator MCP Server</h1>
        <p class="hero-lead">
          Give your AI agent a tool to calculate CVSS Base Scores. Connect an MCP client locally or through the remote endpoint.
        </p>
        <div class="cta-row">
          <a href="/docs/mcp/clients/" class="btn btn-primary">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
              <line x1="8" y1="21" x2="16" y2="21"></line>
              <line x1="12" y1="17" x2="12" y2="21"></line>
            </svg>
            Client setup guides
          </a>
          <a href="/docs/mcp/tools/" class="btn">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
              <polyline points="14 2 14 8 20 8"></polyline>
              <line x1="16" y1="13" x2="8" y2="13"></line>
              <line x1="16" y1="17" x2="8" y2="17"></line>
              <polyline points="10 9 9 9 8 9"></polyline>
            </svg>
            Tool reference
          </a>
          <a href="https://github.com/alfa-reza/cvss-calculator-mcp" class="btn" rel="noopener noreferrer">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path>
            </svg>
            MCP repository
          </a>
          <a href="https://registry.modelcontextprotocol.io/?q=CVSS&all=1" class="btn" rel="noopener noreferrer">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="2" y="2" width="20" height="8" rx="2"></rect>
              <rect x="2" y="14" width="20" height="8" rx="2"></rect>
              <line x1="6" y1="6" x2="6.01" y2="6"></line>
              <line x1="6" y1="18" x2="6.01" y2="18"></line>
            </svg>
            Official MCP Registry
          </a>
        </div>
      </section>

      <section class="section-block" aria-labelledby="setup-heading">
        <div class="section-header">
          <h2 id="setup-heading">Connect to the server</h2>
          <p>Run the server locally or connect to the public endpoint.</p>
        </div>

        <div class="mcp-stack">
          <div class="mcp-panel is-recommended">
            <div class="mcp-panel-header">
              <div class="mcp-title-row">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <polyline points="4 17 10 11 4 5"></polyline>
                  <line x1="12" y1="19" x2="20" y2="19"></line>
                </svg>
                <h3>1. Local MCP (Recommended)</h3>
                <span class="mono-tag">stdio</span>
                <span class="mono-tag">Linux / macOS</span>
              </div>
            </div>
            <p class="mcp-desc">
              Run the server on your machine. The public endpoint rate limit does not apply.
            </p>
            <div class="command-row">
              <pre class="command-code"><code id="mcp-local-cmd">{localInstallCmd}</code></pre>
              <button
                type="button"
                class="btn copy-cmd-btn"
                data-copy-target="mcp-local-cmd"
                data-status-target="mcp-local-status"
              >
                Copy Command
              </button>
            </div>
            <div class="mcp-footer-row">
              <a href="/docs/mcp/local/" class="text-link">Local installation guide</a>
              <span id="mcp-local-status" class="copy-status" role="status" aria-live="polite"></span>
            </div>
          </div>

          <div class="mcp-panel">
            <div class="mcp-panel-header">
              <div class="mcp-title-row">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <circle cx="12" cy="12" r="10"></circle>
                  <line x1="2" y1="12" x2="22" y2="12"></line>
                  <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
                </svg>
                <h3>2. Remote MCP (Free)</h3>
                <span class="mono-tag">Streamable HTTP</span>
              </div>
            </div>
            <p class="mcp-desc">
              Connect your MCP client without installing the server. The endpoint is not a web page.
            </p>
            <div class="command-row">
              <pre class="command-code"><code id="mcp-remote-url">{remoteMcpUrl}</code></pre>
              <button
                type="button"
                class="btn copy-cmd-btn"
                data-copy-target="mcp-remote-url"
                data-status-target="mcp-remote-status"
              >
                Copy Endpoint
              </button>
            </div>
            <p class="mcp-limit-note">
              <strong>Published usage policy:</strong> Rate limit: 5 requests per minute per IP. For higher usage, run Local MCP (stdio).
            </p>
            <McpStatus />
            <div class="mcp-footer-row">
              <a href="/docs/mcp/remote/" class="text-link">Remote connection guide</a>
              <span id="mcp-remote-status" class="copy-status" role="status" aria-live="polite"></span>
            </div>
          </div>
        </div>
      </section>

      <section class="section-block" aria-labelledby="contract-heading">
        <div class="section-header">
          <h2 id="contract-heading">Calculate a score</h2>
          <p>The <code>calculate_cvss</code> tool accepts a complete Base vector and returns its score and severity.</p>
        </div>
        <div class="contract-grid">
          <div class="contract-card">
            <div class="contract-card-intro">
              <div class="contract-card-header">
                <div class="contract-card-title-row">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <polyline points="16 18 22 12 16 6"></polyline>
                    <polyline points="8 6 2 12 8 18"></polyline>
                  </svg>
                  <h3>Input</h3>
                </div>
                <span class="mono-badge">JSON</span>
              </div>
              <p class="contract-card-desc">Provide a CVSS version and a complete Base vector. Vector values are case-sensitive.</p>
            </div>
            <div class="payload-box">
              <pre class="code-payload-block"><code id="mcp-input-payload">{`{
  "version": "3.1",
  "vector": "CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:H/I:H/A:H"
}`}</code></pre>
              <div class="payload-action-row">
                <button
                  type="button"
                  class="btn copy-cmd-btn"
                  data-copy-target="mcp-input-payload"
                  data-status-target="mcp-input-status"
                  aria-label="Copy input arguments JSON"
                >
                  Copy JSON
                </button>
                <span id="mcp-input-status" class="copy-status" role="status" aria-live="polite"></span>
              </div>
            </div>
          </div>
          <div class="contract-card">
            <div class="contract-card-intro">
              <div class="contract-card-header">
                <div class="contract-card-title-row">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                    <polyline points="14 2 14 8 20 8"></polyline>
                    <line x1="16" y1="13" x2="8" y2="13"></line>
                    <line x1="16" y1="17" x2="8" y2="17"></line>
                    <polyline points="10 9 9 9 8 9"></polyline>
                  </svg>
                  <h3>Output</h3>
                </div>
                <span class="mono-badge">JSON</span>
              </div>
              <p class="contract-card-desc">The response includes the version, vector, score, and severity.</p>
            </div>
            <div class="payload-box">
              <pre class="code-payload-block"><code id="mcp-output-payload">{`{
  "version": "3.1",
  "vector": "CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:H/I:H/A:H",
  "score": 9.8,
  "severity": "Critical"
}`}</code></pre>
              <div class="payload-action-row">
                <button
                  type="button"
                  class="btn copy-cmd-btn"
                  data-copy-target="mcp-output-payload"
                  data-status-target="mcp-output-status"
                  aria-label="Copy output payload JSON"
                >
                  Copy JSON
                </button>
                <span id="mcp-output-status" class="copy-status" role="status" aria-live="polite"></span>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section class="section-block" aria-labelledby="next-steps-heading">
        <div class="section-header">
          <h2 id="next-steps-heading">Documentation</h2>
          <p>Set up a client or learn more about the server.</p>
        </div>
        <ul class="docs-index-list">
          <li class="docs-index-item">
            <div class="docs-item-title-row">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
                <line x1="8" y1="21" x2="16" y2="21"></line>
                <line x1="12" y1="17" x2="12" y2="21"></line>
              </svg>
              <a href="/docs/mcp/clients/">Client setup guides</a>
            </div>
            <p>Connect an MCP client to the server.</p>
          </li>
          <li class="docs-index-item">
            <div class="docs-item-title-row">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                <polyline points="14 2 14 8 20 8"></polyline>
                <line x1="16" y1="13" x2="8" y2="13"></line>
                <line x1="16" y1="17" x2="8" y2="17"></line>
              </svg>
              <a href="/docs/mcp/tools/">Tool reference</a>
            </div>
            <p>See input formats and errors for <code>calculate_cvss</code>.</p>
          </li>
          <li class="docs-index-item">
            <div class="docs-item-title-row">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
              </svg>
              <a href="/docs/mcp/security/">Security and privacy</a>
            </div>
            <p>Learn about checksums, network access, and data handling.</p>
          </li>
        </ul>
      </section>
    </main>

    <footer class="site-footer">
      <div class="container footer-inner">
        <div class="footer-links">
          <a href="/">Home</a>
          <a href={`${calcBaseUrl}/v4.0`}>Calculator</a>
          <a href="/docs/mcp/">MCP Docs</a>
          <a href="/docs/mcp/clients/">Client Setup Guides</a>
          <a href="https://github.com/alfa-reza/cvss.my.id" rel="noopener noreferrer">Website &amp; Calculator GitHub</a>
          <a href="https://github.com/alfa-reza/cvss-calculator-mcp" rel="noopener noreferrer">MCP server on GitHub</a>
        </div>
        <p class="footer-attribution">
          CVSS.my.id is an independent open-source project and is not affiliated with FIRST. CVSS is maintained by <a href="https://www.first.org/cvss/" rel="noopener noreferrer">FIRST.org, Inc.</a>
        </p>
        <p class="footer-friendship"><a href="https://alfareza.my.id/" aria-label="Build by Friendship - visit Faturahman Alfareza’s portfolio"><svg class="friendship-mark" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M12 1 13.8 8.8 20 5 16.3 11 23 12 16.3 13 20 19 13.8 15.2 12 23 10.2 15.2 4 19 7.7 13 1 12 7.7 11 4 5 10.2 8.8Z" fill="currentColor"/><circle cx="20.5" cy="3.5" r="1.2" fill="currentColor"/><circle cx="3.5" cy="20.5" r="1" fill="currentColor"/></svg><span>Build by Friendship</span><svg class="friendship-mark" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M12 1 13.8 8.8 20 5 16.3 11 23 12 16.3 13 20 19 13.8 15.2 12 23 10.2 15.2 4 19 7.7 13 1 12 7.7 11 4 5 10.2 8.8Z" fill="currentColor"/><circle cx="20.5" cy="3.5" r="1.2" fill="currentColor"/><circle cx="3.5" cy="20.5" r="1" fill="currentColor"/></svg></a></p>
      </div>
    </footer>

    <script is:inline>
      function flashCopied(btn) {
        if (!btn || btn.dataset.copying === 'true') return;
        var original = btn.innerHTML;
        btn.dataset.copying = 'true';
        btn.classList.add('is-copied');
        btn.innerHTML = '<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg>Copied';
        window.setTimeout(function () {
          btn.classList.remove('is-copied');
          btn.innerHTML = original;
          delete btn.dataset.copying;
        }, 1200);
      }

      document.querySelectorAll('.copy-cmd-btn').forEach(function (btn) {
        btn.addEventListener('click', function () {
          var targetId = btn.getAttribute('data-copy-target');
          var statusId = btn.getAttribute('data-status-target');
          var codeEl = targetId ? document.getElementById(targetId) : null;
          var statusEl = statusId ? document.getElementById(statusId) : null;
          if (!codeEl) return;
          var text = codeEl.textContent || '';
          if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(text).then(
              function () {
                if (statusEl) statusEl.textContent = 'Copied to clipboard.';
                flashCopied(btn);
              },
              function () {
                if (statusEl) statusEl.textContent = 'Clipboard blocked; select and copy the text above.';
              }
            );
          } else if (statusEl) {
            statusEl.textContent = 'Select and copy the text above.';
          }
        });
      });

      (function() {
        var toggleBtn = document.getElementById('theme-toggle');
        if (!toggleBtn) return;

        var media = window.matchMedia('(prefers-color-scheme: light)');
        function updateBtn() {
          var theme = document.documentElement.getAttribute('data-theme') || (media.matches ? 'light' : 'dark');
          toggleBtn.setAttribute('aria-label', 'Color theme: ' + theme + '. Switch to ' + (theme === 'light' ? 'dark' : 'light'));
          toggleBtn.setAttribute('title', 'Switch to ' + (theme === 'light' ? 'dark' : 'light') + ' theme');
          toggleBtn.querySelector('.theme-toggle-text').textContent = theme === 'light' ? 'Light' : 'Dark';
        }
        toggleBtn.addEventListener('click', function() {
          var current = document.documentElement.getAttribute('data-theme') || (media.matches ? 'light' : 'dark');
          var next = current === 'light' ? 'dark' : 'light';
          document.documentElement.setAttribute('data-theme', next);
          try {
            localStorage.setItem('theme', next);
            localStorage.setItem('starlight-theme', next);
          } catch (_) {}
          updateBtn();
        });
        media.addEventListener('change', updateBtn);
        updateBtn();
      })();
    </script>
  </body>
</html>
