---
const { siteTitleHref } = Astro.locals.starlightRoute;
---

<a href={siteTitleHref} class="site-title brand-link" translate="no">
  <svg class="brand-logo-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M12 2v3"></path>
    <path d="M3.34 19a10 10 0 1 1 17.32 0"></path>
    <path d="m12 14 4.5-4.5"></path>
    <circle cx="12" cy="14" r="1.5" fill="currentColor"></circle>
  </svg>
  <span class="brand-text">
    <span class="brand-name">CVSS</span><span class="brand-tld">.my.id</span>
  </span>
</a>

<style>
  .site-title.brand-link {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    min-height: 44px;
    text-decoration: none;
    color: var(--sl-color-white);
  }

  .site-title.brand-link:hover {
    text-decoration: none;
  }

  .brand-logo-icon {
    box-sizing: border-box;
    width: 28px;
    height: 28px;
    padding: 4px;
    flex-shrink: 0;
    color: var(--fg);
    background-color: var(--surface);
    border: 1px solid var(--border);
    border-radius: 6px;
    transition: background-color 0.16s ease, border-color 0.16s ease;
  }

  .site-title.brand-link:hover .brand-logo-icon {
    background-color: var(--elevated);
    border-color: var(--border-control);
  }

  .brand-text {
    display: inline-flex;
    align-items: baseline;
  }

  .brand-name {
    font-family: var(--sl-font);
    font-size: 1rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    line-height: 1;
    color: var(--fg);
    text-transform: uppercase;
  }

  .brand-tld {
    margin-left: 3px;
    font-family: "Segoe Print", "Bradley Hand", "Comic Sans MS", cursive;
    font-size: 0.8125rem;
    font-weight: 400;
    letter-spacing: 0;
    color: var(--muted);
    transition: color 0.16s ease;
  }

  .site-title.brand-link:hover .brand-tld {
    color: var(--fg);
  }
</style>
